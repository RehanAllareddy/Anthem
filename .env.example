# ---- Claude (lyrics + wellbeing screening) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Vocals ----
# elevenlabs | local | auto (auto = ElevenLabs if a key is set, otherwise local TTS)
VOCAL_PROVIDER=auto
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: swap the preset voices for any voice IDs in your ElevenLabs library
# ELEVENLABS_VOICE_WARM=
# ELEVENLABS_VOICE_BRIGHT=
# ELEVENLABS_VOICE_DEEP=
# ELEVENLABS_VOICE_SMOOTH=

# ---- Storage & background work ----
# auto: Vercel Blob when a store is connected (BLOB_STORE_ID / BLOB_READ_WRITE_TOKEN), else ./storage on disk
STORAGE_BACKEND=auto
# auto: Vercel Queues on Vercel preview/production, in-process threads everywhere else
TASK_BACKEND=auto
# Only needed to use a Blob store from your machine; on Vercel the connected store is used automatically.
# BLOB_READ_WRITE_TOKEN=

# ---- Privacy ----
RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# ---- Local server ----
MAX_WORKERS=2
